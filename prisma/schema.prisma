generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model EventStore {
  id         String   @id @default(uuid())
  streamId   String
  streamType String
  eventType  String
  payload    Json
  version    Int
  occurredAt DateTime @default(now())
  position   BigInt   @unique @default(autoincrement())

  @@unique([streamId, version])
  @@index([streamId])
  @@map("event_store")
}

model ActiveAuctionView {
  id         String   @id
  sellerId   String
  title      String
  status     String
  currentBid Float?
  currency   String
  startsAt   DateTime
  endsAt     DateTime
  totalBids  Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("active_auctions_view")
}

model WatchlistAuctionCatalog {
  auctionId  String   @id
  title      String
  status     String
  currentBid Float?
  currency   String
  startsAt   DateTime
  updatedAt  DateTime @updatedAt

  favorites FavoriteView[]

  @@map("watchlist_auction_catalog_view")
}

model FavoriteView {
  bidderId    String
  auctionId   String
  favoritedAt DateTime

  auction WatchlistAuctionCatalog @relation(fields: [auctionId], references: [auctionId])

  @@id([bidderId, auctionId])
  @@map("favorites_view")
}

model ProjectionCheckpoint {
  subscriberName String   @id
  position       BigInt   @default(0)
  updatedAt      DateTime @updatedAt

  @@map("projection_checkpoints")
}
