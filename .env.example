# Development database — used by the app (`npm run dev`) and by Prisma migrations.
DATABASE_URL="postgresql://bidflow:bidflow@localhost:5433/bidflow?schema=public"

# Integration tests run against a SEPARATE database — they TRUNCATE every table.
# The name must end with "_test" (enforced by scripts/testDatabaseUrl.ts).
# Create it once:  docker exec architecture-postgres-1 createdb -U bidflow bidflow_test
# Apply the schema: npm run db:test:migrate
DATABASE_URL_TEST="postgresql://bidflow:bidflow@localhost:5433/bidflow_test?schema=public"
