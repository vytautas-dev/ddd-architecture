# Development database — used by the app (`npm run dev`) and by Prisma migrations.
DATABASE_URL="postgresql://bidflow:bidflow@localhost:5433/bidflow?schema=public"

# Pulsar broker from docker-compose.yml (`docker compose up -d`).
PULSAR_URL="pulsar://localhost:6650"

# Tests need no database settings: `npm test` starts its own disposable
# Postgres and Pulsar containers (jest.globalSetup.ts) and never touches the
# development database.
